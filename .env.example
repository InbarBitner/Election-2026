# Copy to web/.env (Prisma reads it from there) and adjust.

# Development: a local SQLite file, resolved relative to web/prisma/.
DATABASE_URL="file:../../data/election.db"

# Production: a managed Postgres warehouse. Switch `provider` in
# web/prisma/schema.prisma to "postgresql" as well — the schema itself is
# written to be provider-neutral, so nothing else has to change.
# DATABASE_URL="postgresql://user:password@host:5432/election2026"

# Optional. Without it the daily brief is written by the deterministic
# template instead of by Claude; everything else works unchanged.
# ANTHROPIC_API_KEY="sk-ant-..."
